<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Taps for a linked iPhone arrive over APNs. App Store exports switch
	     this to production. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Invite (/join) and computer sign-in (/qr) links open the app.
	     apps/web/public/.well-known/apple-app-site-association lists it. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:shouldertap.app</string>
	</array>
	<!-- Tap notifications break through Focus (no Apple approval needed). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
