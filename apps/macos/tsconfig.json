{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": [],
    "lib": ["es2022"],
    "paths": {
      "@shouldertap/domain": ["../../packages/domain/src/index.ts"],
      "@shouldertap/client": ["../../packages/client/src/index.ts"],
