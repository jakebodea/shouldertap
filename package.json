{
  "name": "shouldertap",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/server",
      "apps/web",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@types/node": "^26.4.1",
      "@cloudflare/workers-types": "^5.20260906.1",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "effect": "4.0.0-rc.115",
      "vitest": "^5.0.3",
      "@effect/vitest": "4.0.0-rc.115"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "tsc --noEmit && turbo run check-types",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev",
    "fix": "ultracite fix",
    "plan": "alchemy plan",
    "test": "turbo run test //#test:root",
    "test:root": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@shouldertap/config": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "catalog:",
    "alchemy": "2.0.0-beta.79",
    "effect": "catalog:",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.12.4",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@effect/sql-d1": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  },
  "packageManager": "bun@1.4.2"
}
