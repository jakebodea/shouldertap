{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"],
      "cache": false
    },
    "//#test:root": {
      "cache": false
    }
  },
  "globalEnv": ["CI", "NODE_ENV", "VITE_SERVER_URL"],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
